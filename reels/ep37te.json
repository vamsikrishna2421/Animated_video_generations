     "gap": 0.16,
     "tempo": 1.1,
     "tts": "దీని పేరు Quantization.",
     "file2": "04b_ai.wav",
     "tts2": "నా బ్రేన్ లో ప్రతి నంబర్ ని రౌండ్ చేయడం.",
     "pause": 0.3,
     "gain_db": -0.6
    },
    {
     "who": "ravi",
     "file": "05_ravi.wav",
     "text": "రౌండ్ చేయడమా? నా రేట్ల లాగానా?",
