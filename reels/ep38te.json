   "lines": [
    {
     "who": "ravi",
     "file": "01_ravi.wav",
     "text": "మెమరీ సరిపోలేదా?! ఫైవ్ ట్వెల్వ్ జీబీకి డబ్బులు కట్టా!",
     "show": "Memory not enough?! I paid for 512 GB!",
     "maxgap": 0.28,
     "gap": 0.2,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "02_ai.wav",
     "text": "అది స్టోరేజ్ అండి. [1] మన గోదాం.",
     "show": "That's storage. Our godown.",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.14,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "03_ravi.wav",
     "text": "అయితే ఏంటి? బ్రేన్ అందులోనే ఉంది కదా!",
     "show": "So what? The brain is in there!",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "04_ai.wav",
     "text": "ప్రతి మాటకీ నేను ప్రతి బస్తా వాడతా. <pause 0.25> [1] అందుకే అన్నీ ర్యామ్ అనే కౌంటర్ మీద ఉండాలి.",
     "show": "For every word I use every sack. So all of them must sit on the counter called RAM.",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.14,
     "tts": "ప్రతి మాటకీ నేను ప్రతి బస్తా వాడతా.",
     "file2": "04b_ai.wav",
     "tts2": "అందుకే అన్నీ ర్యామ్ అనే కౌంటర్ మీద ఉండాలి.",
     "pause": 0.25,
     "gain_db": -1.0
    },
    {
