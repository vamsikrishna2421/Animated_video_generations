    {
     "who": "laptop",
     "file": "01_laptop.wav",
     "text": "Hello! This voice was made on a laptop, with no internet.",
     "show": "Hello! This voice was made on a laptop, with no internet.",
     "maxgap": 2.0,
     "gap": 0.25,
     "tempo": 1.0,
     "demo": "series/scripts/howto01_demo/0.wav"
    },
    {
     "who": "ravi",
     "file": "02_ravi.wav",
     "text": "చింటూ ల్యాప్‌టాప్ లో ఎవరున్నారు?! వైఫై కూడా ఆఫ్!",
     "show": "Who's inside Chintu's laptop?! The Wi-Fi is off!",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "03_ai.wav",
     "text": "ఎవరూ లేరు. ఫ్రీ వాయిస్ మోడల్, ల్యాప్‌టాప్ లోనే నడుస్తుంది.",
     "show": "Nobody. A free voice model, running on the laptop itself.",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.16,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "04_ravi.wav",
     "text": "ఫ్రీ నా? నా ఆఫర్ అనౌన్స్‌మెంట్ల కోసం ప్రతి నెలా ఒక యాప్ కి కడుతున్నా!",
     "show": "Free? I pay an app every month for my offer announcements!",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    }
