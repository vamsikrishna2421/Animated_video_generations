   "lines": [
    {
     "who": "ravi",
     "file": "12_ravi.wav",
     "text": "కానీ నా కస్టమర్లు తెలుగు మాట్లాడతారు!",
     "show": "But my customers speak Telugu!",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "13_ai.wav",
     "text": "ఇది తెలుగు మాట్లాడదు. తెలుగుకి ఇండిక్ పార్లర్ టీటీఎస్. [1] గొంతు ఎలా ఉండాలో మాటల్లో చెప్తావు.",
     "show": "This one doesn't speak Telugu. For Telugu: Indic Parler TTS. You describe the voice in words.",
     "maxgap": 0.28,
     "gap": 0.4,
     "tempo": 1.16,
     "gain_db": -1.0
    },
    {
     "who": "laptop",
     "file": "14_laptop.wav",
     "text": "నమస్కారం! ఈ గొంతు ఇంటర్నెట్ లేకుండా ఒక ల్యాప్‌టాప్ లో తయారైంది.",
     "show": "\"Namaskaram! This voice was made on a laptop, with no internet.\"",
     "maxgap": 2.0,
     "gap": 0.4,
     "tempo": 1.0,
     "demo": "series/scripts/howto01_demo/parler_run1.wav"
    },
    {
     "who": "ravi",
     "file": "15_ravi.wav",
     "text": "తెలుగు! ఎంత టైం పట్టింది?",
     "show": "Telugu! How long did that take?",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "16_ai.wav",
     "text": "ఒక్కో వాక్యానికి ఇరవై ఎనిమిది సెకన్లు, ఐదు జీబీ మెమరీ. అయినా ఫ్రీ, ఆఫ్‌లైన్.",
     "show": "28 seconds a sentence, 5 GB of memory. Still free, offline.",
     "maxgap": 0.28,
     "gap": 0.7,
     "tempo": 1.16,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "17_ravi.wav",
