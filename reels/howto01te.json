   "lines": [
    {
     "who": "ai",
     "file": "05_ai.wav",
     "text": "మొదటి స్టెప్: ఇన్‌స్టాల్ చెయ్.",
     "show": "Step one: install it.",
     "maxgap": 0.28,
     "gap": 0.6,
     "tempo": 1.16,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "06_ravi.wav",
     "text": "టైప్ చెయ్యాలా?! నేను ఒక్క వేలితో టైప్ చేస్తా!",
     "show": "Type it?! I type with one finger!",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "07_ai.wav",
     "text": "అయితే ఇది కాపీ చెయ్. ఏడు లైన్లు. [1] నీ మాట ఇక్కడ పెట్టు.",
     "show": "Then copy this. 7 lines. Your sentence goes here.",
     "maxgap": 0.28,
     "gap": 0.5,
     "tempo": 1.16,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "08_ravi.wav",
     "text": "తర్వాత?",
     "show": "And then?",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "09_ai.wav",
     "text": "రన్ చెయ్. మొదటిసారి వాయిస్ డౌన్‌లోడ్ అవుతుంది: మూడు వందల పదమూడు ఎంబీ.",
     "show": "Run it. The first time, it downloads the voice: 313 MB.",
     "maxgap": 0.28,
     "gap": 0.6,
     "tempo": 1.16,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "10_ravi.wav",
     "text": "ఆ తర్వాత ఇంటర్నెట్ అక్కర్లేదా?",
     "show": "And after that, no internet?",
     "maxgap": 0.28,
     "gap": 0.16,
     "tempo": 1.2,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "11_ai.wav",
     "text": "వైఫై ఆఫ్. నాలుగు సెకన్ల మాటకి, ఒకటిన్నర సెకన్ల లోపే.",
     "show": "Wi-Fi off: under 1.5 seconds for a 4-second sentence.",
     "maxgap": 0.28,
     "gap": 0.7,
     "tempo": 1.16,
     "gain_db": -1.0
    }
   ]
