   "lines": [
    {
     "who": "arjun",
     "file": "04_arjun.wav",
     "text": "రిలాక్స్ మేడమ్. నా డైరీ లాగా ప్రైవేట్.",
     "show": "Relax, ma'am. It's private, like my diary.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "lakshmi",
     "file": "05_lakshmi.wav",
     "text": "ఫ్రీ చాట్‌బాట్లలో మన చాట్స్ తో ఏఐ ని ట్రైన్ చెయ్యొచ్చు. [1] కొన్ని చాట్స్ ని నిజం మనుషులు చదువుతారు.",
     "show": "On free chatbots, chats can train the AI. And some chats are read by real people.",
     "maxgap": 0.3,
     "gap": 0.5
    },
    {
     "who": "arjun",
     "file": "06_arjun.wav",
     "text": "సరే సరే! తర్వాత చాట్ డిలీట్ చేస్తా.",
     "show": "Okay, okay! I'll delete the chat after.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "lakshmi",
     "file": "07_lakshmi.wav",
     "text": "గూగుల్ పేజీనే చెప్తోంది: రివ్యూయర్ చదివిన చాట్స్ [1] మూడేళ్ల వరకు ఉంటాయి. డిలీట్ చేసినా సరే.",
     "show": "Google's own page: chats a reviewer read stay up to three years. Even after you delete.",
     "maxgap": 0.3,
     "gap": 0.6,
     "pauses": {
      "1": 0.5
     },
     "gain_db": 1.0
    },
    {
     "who": "arjun",
     "file": "08_arjun.wav",
     "text": "మూడేళ్లా?! [1] అయితే ఏఐ వాడకూడదా?",
     "show": "Three years?! So I can't use AI at all?",
