   "lines": [
    {
     "who": "arjun",
     "file": "04_arjun.wav",
     "text": "రిలాక్స్ మేడమ్. నేను, ఏఐ తప్ప ఎవరూ చూడరు.",
     "show": "Relax! Only me and the AI see it.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "lakshmi",
     "file": "05_lakshmi.wav",
     "text": "మనం టైప్ చేసేది ఏఐ ట్రైనింగ్ కి వాడుకోవచ్చు. [1] కొన్నిటిని నిజంగా మనుషులే చదువుతారు.",
     "show": "Your chats can train the AI. And some are read by real people.",
     "maxgap": 0.3,
     "gap": 0.5
    },
    {
     "who": "arjun",
     "file": "06_arjun.wav",
     "text": "సరే సరే! తర్వాత చాట్ డిలీట్ చేస్తా.",
     "show": "Okay, okay! I'll delete the chat after.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "lakshmi",
     "file": "07_lakshmi.wav",
     "text": "మనుషులు చదివిన చాట్ ని గూగుల్ [1] మూడేళ్ల వరకు ఉంచుతుంది. డిలీట్ చేసినా సరే.",
     "show": "If a person reviewed your chat, Google keeps it... up to three years. Even after you delete it.",
     "maxgap": 0.3,
     "gap": 0.6,
     "pauses": {
      "1": 0.8
     },
     "gain_db": 1.0
    },
    {
     "who": "arjun",
     "file": "08_arjun.wav",
     "text": "మూడేళ్లా?! [1] అయితే ఏఐ వాడకూడదా?",
     "show": "Three years?! So I can't use AI at all?",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    }
