   "lines": [
    {
     "who": "naveen",
     "file": "14_naveen.wav",
     "text": "ఉద్యోగం వెతుకుతున్నారా? [1] జాబ్ పోస్ట్ లో ఉన్న మాటలే, అక్షరం మార్చకుండా రాయండి.",
     "show": "Job hunting? Write the job post's own words, without changing a letter.",
     "maxgap": 0.28,
     "gap": 0.5,
     "tempo": 1.04
    },
    {
     "who": "shalini",
     "file": "15_shalini.wav",
     "text": "రిక్రూట్ చేస్తున్నారా? [1] ప్రతి వారం ఇరవై రిజెక్ట్ లు మనిషి చదవాలి.",
     "show": "Recruiting? Every week a human reads 20 rejects.",
     "maxgap": 0.28,
     "gap": 0.6,
     "tempo": 1.0
    },
    {
     "who": "shalini",
     "file": "16_shalini.wav",
     "text": "ఒక్క సెకనులో చదివే రోబో కావాలా... [1] మూడు వారాలు తీసుకునే మనిషా?",
     "show": "A robot that reads you in one second... or a human who takes three weeks?",
     "maxgap": 0.28,
     "gap": 0.4,
     "tempo": 1.0
    },
    {
     "who": "bouncer",
     "file": "17_bouncer.wav",
