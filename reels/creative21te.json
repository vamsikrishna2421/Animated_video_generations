   "lines": [
    {
     "who": "shalini",
     "file": "01_shalini.wav",
     "text": "ఎనిమిది నెలలు! [1] ఒక్కరినీ తీసుకోలేదు! [2] డాట్ నెట్ డెవలపర్స్ ఎక్కడ?!",
     "show": "8 months! Not one hired! Where are the .NET developers?!",
     "maxgap": 0.28,
     "gap": 0.25,
     "tempo": 1.0
    },
    {
     "who": "bouncer",
     "file": "02_bouncer.wav",
     "text": "రిజెక్టెడ్. [1] లిస్ట్ లో లేదు.",
     "show": "Rejected. Not on the list.",
     "maxgap": 0.28,
     "gap": 0.2,
     "tempo": 0.98
    },
    {
     "who": "naveen",
     "file": "03_naveen.wav",
     "text": "ఐదేళ్ళ డాట్ నెట్ అనుభవం! [1] మీకు కావాల్సింది నేనే!",
     "show": "5 years of .NET experience! I'm the one you need!",
     "maxgap": 0.28,
     "gap": 0.25,
     "tempo": 1.04
    },
    {
     "who": "bouncer",
     "file": "04_bouncer.wav",
     "text": "లిస్ట్ లో డాట్, ఎన్, ఈ, టీ. [1] నువ్వు రాసింది డీ, ఓ, టీ, ఎన్, ఈ, టీ.",
     "show": "The list says dot, N, E, T. You wrote D, O, T, N, E, T.",
     "maxgap": 0.28,
     "gap": 0.5,
     "tempo": 0.98
    },
    {
     "who": "shalini",
     "file": "05_shalini.wav",
     "text": "రెండూ ఒకటే కదా!",
     "show": "Both are the same!",
     "maxgap": 0.28,
     "gap": 0.2,
     "tempo": 1.0
    },
    {
     "who": "bouncer",
     "file": "06_bouncer.wav",
     "text": "నేను అక్షరాలు చూస్తా, [1] అర్థం చూడను.",
     "show": "I look at letters, not meaning.",
     "maxgap": 0.28,
