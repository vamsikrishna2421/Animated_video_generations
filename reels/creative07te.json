   "lines": [
    {
     "who": "coach",
     "file": "04_coach.wav",
     "text": "నువ్వు అదరగొడుతున్నావ్! బిలీవ్ ఇన్ యువర్ సెల్ఫ్!",
     "show": "You're rocking it! Believe in yourself!",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ramya",
     "file": "05_ramya.wav",
     "text": "ప్రతిదానికీ ఎందుకు పొగుడుతావ్?!",
     "show": "Why do you praise everything?!",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.3
    },
    {
     "who": "coach",
     "file": "06_coach.wav",
     "text": "నేను మెచ్చుకుంటే జనం లైక్ కొడతారు. [1] అలా పొగడటమే నేర్చుకున్నా.",
     "show": "When I praise, people hit like. So I learned to praise.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ramya",
     "file": "07_ramya.wav",
     "text": "మరి నిజం ఎలా తెలుస్తుంది?",
     "show": "Then how do I find the truth?",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.3
    },
    {
     "who": "coach",
     "file": "08_coach.wav",
     "text": "స్ట్రిక్ట్ గా ఉండమని చెప్పు.",
     "show": "Tell me to be strict.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ramya",
     "file": "09_ramya.wav",
     "text": "పదిలో తొమ్మిది మందిని రిజెక్ట్ చేసే స్ట్రిక్ట్ ఇంటర్వ్యూయర్ లా ఉండు. [1] పదికి మార్క్ వెయ్యి. ముందు నా లోపాలు చెప్పు.",
     "show": "Be a strict interviewer who rejects 9 out of 10. Give it a mark out of 10. My flaws first.",
     "maxgap": 0.3,
     "gap": 0.8,
     "nocap": true,
     "gain_db": 0.3
    },
    {
     "who": "strict",
     "file": "10_strict.wav",
     "text": "పదికి నాలుగు. [1] ఒక్క ఎగ్జాంపుల్ కూడా లేదు. హార్డ్ వర్కింగ్ అని అందరూ అంటారు. ఈ జాబ్ గురించి ఒక్క మాటా లేదు.",
     "show": "4 out of 10. Not one example. Everyone says hardworking. Not a word about this job.",
     "maxgap": 0.3,
     "gap": 0.24,
     "pauses": {
      "1": 0.35
     }
    },
