   "lines": [
    {
     "who": "storyteller",
     "file": "07_storyteller.wav",
     "text": "మేము గీసిన ఇరవై నాలుగు మీటర్ ఫోటోలు, ఒక చిన్న ఫ్రీ ఏ ఐ కి ఇచ్చాం. [1] ఒక్కటి కూడా సరిగ్గా చదవలేదు.",
     "show": "We gave 24 meter photos we drew to a small free AI. It didn't read even one right.",
     "maxgap": 0.32,
     "gap": 0.4,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "08_storyteller.wav",
     "text": "అవే పన్నెండు నంబర్లు, మామూలుగా ప్రింట్ చేస్తే? [1] పన్నెండుకి పన్నెండు.",
     "show": "The same 12 numbers, printed normally? 12 out of 12.",
     "maxgap": 0.32,
     "gap": 0.4,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "09_storyteller.wav",
     "text": "అందుకే యాప్ రీడింగ్ చూపించగానే, [1] ఓకే నొక్కే ముందు, [2] మీటర్ తో ఒక్కో అంకె చెక్ చేయండి.",
     "show": "So when the app shows the reading, before you press OK, check it against the meter, digit by digit.",
     "maxgap": 0.32,
     "gap": 1.0,
     "tempo": 1.0
    }
   ]
