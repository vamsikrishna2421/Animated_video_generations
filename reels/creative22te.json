   "lines": [
    {
     "who": "storyteller",
     "file": "01_storyteller.wav",
     "text": "ఎప్పుడూ తొమ్మిది వందల అరవై రూపాయలు. [1] ఈ నెల, లక్షా అరవై వేలు! కమలమ్మ కరెంట్ బిల్లు.",
     "show": "Always ₹960. This month: ₹1,60,000! Kamala amma's power bill.",
     "maxgap": 0.32,
     "gap": 0.35,
     "tempo": 1.0
    },
    {
     "who": "kamala",
     "file": "02_kamala.wav",
     "text": "లక్ష రూపాయలా? [1] ఒక ఫ్యాన్, ఒక ఫ్రిజ్ కి?",
     "show": "One lakh rupees? For one fan and one fridge?",
     "maxgap": 0.32,
     "gap": 0.3,
     "tempo": 0.98
    },
    {
     "who": "storyteller",
     "file": "03_storyteller.wav",
     "text": "ప్రతి నెలా కమలమ్మ మీటర్ ఫోటో తీస్తుంది, [1] ఒక యాప్ దాన్ని చదువుతుంది.",
     "show": "Every month Kamala amma photographs the meter; an app reads it.",
     "maxgap": 0.32,
     "gap": 0.3,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "04_storyteller.wav",
     "text": "ఈసారి యాప్, ఆరుని [1] ఎనిమిదిగా చదివింది.",
     "show": "This time the app read her 6 as an 8.",
     "maxgap": 0.32,
     "gap": 0.35,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "05_storyteller.wav",
     "text": "రెండు అంకెలు తప్పు: [1] ఇరవై వేల యూనిట్లు ఎక్స్ ట్రా.",
     "show": "Two digits wrong: 20,000 extra units.",
     "maxgap": 0.32,
     "gap": 0.4,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "06_storyteller.wav",
     "text": "ఎనిమిదిలో ఒక గీత తీసేస్తే, [1] అదే ఆరు.",
     "show": "Take one line out of an 8, and it's a 6.",
     "maxgap": 0.32,
     "gap": 0.45,
     "tempo": 1.0
    }
   ]
  },
