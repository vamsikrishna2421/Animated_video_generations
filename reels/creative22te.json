   "lines": [
    {
     "who": "storyteller",
     "file": "01_storyteller.wav",
     "text": "ఎప్పుడూ తొమ్మిది వందల అరవై రూపాయలు. [1] ఈ నెల, లక్షా అరవై వేలు! కమలమ్మ కరెంట్ బిల్లు.",
     "show": "Always ₹960. This month: ₹1,60,000! Kamala amma's power bill.",
     "maxgap": 0.32,
     "gap": 0.35,
     "tempo": 1.0
    },
    {
     "who": "kamala",
     "file": "02_kamala.wav",
     "text": "లక్ష రూపాయలా? [1] ఒక ఫ్యాన్, ఒక ఫ్రిజ్ కి?",
     "show": "One lakh rupees? For one fan and one fridge?",
     "maxgap": 0.32,
     "gap": 0.3,
     "tempo": 0.98
    },
    {
     "who": "storyteller",
     "file": "03_storyteller.wav",
     "text": "ప్రతి నెలా ఆమె మీటర్ ఫోటో తీస్తుంది, [1] ఒక యాప్ దాన్ని చదువుతుంది.",
     "show": "Every month she photographs the meter; an app reads it.",
     "maxgap": 0.32,
     "gap": 0.3,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "04_storyteller.wav",
     "text": "ఈసారి యాప్ చదివింది: [1] ఎనిమిది, ఆరు, ఒకటి, ఒకటి, ఒకటి.",
     "show": "This time the app read: 8, 6, 1, 1, 1.",
     "maxgap": 0.32,
     "gap": 0.35,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "05_storyteller.wav",
     "text": "మీటర్ లో ఉన్నది: [1] ఆరు, ఆరు, ఒకటి, ఒకటి, నాలుగు.",
     "show": "What the meter shows: 6, 6, 1, 1, 4.",
     "maxgap": 0.32,
     "gap": 0.4,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "06_storyteller.wav",
     "text": "మీటర్ మీద, ఆరు అంటే, [1] ఒక గీత తక్కువ ఎనిమిది.",
     "show": "On a meter, a 6 is an 8 with one line less.",
     "maxgap": 0.32,
     "gap": 0.45,
     "tempo": 1.0
    }
   ]
