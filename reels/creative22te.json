   "lines": [
    {
     "who": "storyteller",
     "file": "07_storyteller.wav",
     "text": "ఫోటోలు చదివే ఒక చిన్న ఫ్రీ ఏ ఐ కి, ఇరవై నాలుగు మీటర్ ఫోటోలు ఇచ్చాం. [1] ఒక్కటి కూడా సరిగ్గా చదవలేదు.",
     "show": "We gave a small free AI that reads photos 24 meter photos. It didn't read even one right.",
     "maxgap": 0.32,
     "gap": 0.4,
     "tempo": 1.0
    },
    {
     "who": "storyteller",
     "file": "08_storyteller.wav",
     "text": "అవే నంబర్లు, మామూలుగా ప్రింట్ చేస్తే? [1] పన్నెండుకి పన్నెండు.",
     "show": "The same numbers, printed normally? 12 out of 12.",
     "maxgap": 0.32,
     "gap": 0.5,
     "tempo": 1.0
    },
    {
     "who": "kamala",
     "file": "09_kamala.wav",
     "text": "ముప్పై ఐదేళ్ళు, [1] పేపర్లు దిద్దాను.",
     "show": "35 years, I corrected papers.",
     "maxgap": 0.32,
     "gap": 0.4,
     "tempo": 0.98
    }
   ]
