     "gain_db": 0.5
    },
    {
     "who": "babu",
     "file": "02_babu.wav",
     "text": "అదే పదిహేను రూపాయలు! [1] ఏఐ కి ఫ్యాన్సీగా రాయమన్నా, అంతే.",
     "show": "Same fifteen rupees! I only told the AI: make it fancy.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "raju",
     "file": "03_raju.wav",
     "text": "మామూలుగా రాయమను!",
     "show": "Then tell it: normal!",
     "maxgap": 0.3,
