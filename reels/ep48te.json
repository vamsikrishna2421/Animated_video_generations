   "lines": [
    {
     "who": "ravi",
     "file": "01_ravi.wav",
     "text": "లేబుల్ అక్కర్లేదా?! [1] ఫిబ్రవరి నుంచే రూల్ ఉంది!",
     "show": "No label needed?! It's the rule since February!",
     "maxgap": 0.22,
     "gap": 0.1,
     "tempo": 1.0,
     "gain_db": 2.0
    },
    {
     "who": "ai",
     "file": "02_ai.wav",
     "text": "మీ ఏఐ యాడ్ కి లేబుల్ కావాలా అని అడిగారు. [1] నేను అక్కర్లేదు అన్నాను.",
     "show": "You asked if your AI ad needs a label. I said no need.",
     "maxgap": 0.22,
     "gap": 0.1,
     "tempo": 1.0,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "03_ravi.wav",
     "text": "ఆ డాన్స్ నాది కాదు! [1] చూసేవాళ్ళు నిజమే అనుకుంటారు!",
     "show": "That dance isn't mine! People will think it's real!",
     "maxgap": 0.22,
     "gap": 0.2,
     "tempo": 1.0,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "04_ai.wav",
     "text": "అదే రూల్. ఫిబ్రవరి ఇరవై నుంచి, [1] నిజంలా కనిపించే ఏఐ వీడియో, ఫోటో, వాయిస్ కి, క్లియర్ లేబుల్ పెట్టాలి.",
     "show": "That's the rule. From 20 February, AI video, photo or voice that looks real needs a clear label.",
     "maxgap": 0.22,
     "gap": 0.25,
     "tempo": 1.0,
     "gain_db": -1.0
    },
    {
     "who": "ravi",
     "file": "05_ravi.wav",
     "text": "మరి ఎందుకు అక్కర్లేదు అన్నావు?!",
     "show": "Then why did you say no?!",
     "maxgap": 0.22,
     "gap": 0.15,
     "tempo": 1.0,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "06_ai.wav",
     "text": "నేను ఒక చిన్న ఫ్రీ ఏఐ ని, పాతదాన్ని. [1] ఈ రూల్ నా తర్వాత వచ్చింది.",
     "show": "I'm a small free AI, an old one. This rule came after me.",
     "maxgap": 0.22,
     "gap": 0.25,
     "tempo": 1.0,
     "gain_db": -1.0
    }
   ]
  },
