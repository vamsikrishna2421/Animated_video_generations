    {
     "who": "sarojini",
     "file": "01_sarojini.wav",
     "text": "ఆర్జే గారూ, <pause 0.3> [1] చాట్ బాట్ మా అమ్మకి పెళ్ళి చేసేసింది!",
     "show": "RJ garu, <pause 0.3> the chatbot married off my mother!",
     "maxgap": 0.28,
     "gap": 0.3,
     "tempo": 1.0,
     "tts": "ఆర్జే గారూ,",
     "file2": "01b_sarojini.wav",
     "tts2": "చాట్ బాట్ మా అమ్మకి పెళ్ళి చేసేసింది!",
     "pause": 0.3,
     "gain_db": 0.5
    },
    {
     "who": "bunny",
     "file": "02_bunny.wav",
     "text": "మీ అమ్మకా?! [1] ఏం రాసింది?",
     "show": "Your mother?! What did it write?",
     "maxgap": 0.28,
     "gap": 0.25,
     "tempo": 1.0,
     "gain_db": 0.5
    },
    {
     "who": "sarojini",
     "file": "03_sarojini.wav",
     "text": "\"అవర్ మదర్స్ డ్రీమ్ వెడ్డింగ్ విత్ కళ్యాణ్\". <pause 0.3> [1] మా స్వప్న ఎక్కడ?",
     "show": "\"Our mother's dream wedding with Kalyan.\" <pause 0.3> Where is our Swapna?",
     "maxgap": 0.28,
     "gap": 0.3,
     "tempo": 1.0,
     "tts": "\"అవర్ మదర్స్ డ్రీమ్ వెడ్డింగ్ విత్ కళ్యాణ్\".",
     "file2": "03b_sarojini.wav",
     "tts2": "మా స్వప్న ఎక్కడ?",
     "pause": 0.3,
     "gain_db": 0.5
    },
    {
     "who": "bunny",
     "file": "04_bunny.wav",
     "text": "స్వప్న అంటే డ్రీమ్ కదా! [1] పేరుని కూడా ట్రాన్స్ లేట్ చేసేసింది.",
     "show": "Swapna means dream! It translated even her name.",
     "maxgap": 0.28,
     "gap": 0.3,
     "tempo": 1.0,
     "gain_db": 0.5
    },
    {
     "who": "sarojini",
     "file": "05_sarojini.wav",
     "text": "\"మా అమ్మాయి\" ని [1] \"మా అమ్మ\" చేసేసింది!",
     "show": "\"Our girl\" became \"our mother\"!",
     "maxgap": 0.28,
     "gap": 0.4,
     "tempo": 1.0,
     "gain_db": 0.5
    }
   ]
