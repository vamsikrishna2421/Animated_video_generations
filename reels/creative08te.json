   "lines": [
    {
     "who": "teja",
     "file": "01_teja.wav",
     "text": "మూడు లక్షలా?! నాన్న ఆటో కూడా ఎక్కరు!",
     "show": "3 lakhs?! Nanna won't even take an auto!",
     "maxgap": 0.3,
     "gap": 0.2,
     "gain_db": 0.3
    },
    {
     "who": "kavya",
     "file": "02_kavya.wav",
     "text": "పాతికేళ్ల పెళ్లి రోజుకి ప్లాన్ అడిగాం, [1] రిసెప్షన్ కాదు!",
     "show": "We asked for their 25th anniversary plan, [1] not a reception!",
     "maxgap": 0.3,
     "gap": 0.2,
     "gain_db": 0.3
    },
    {
     "who": "kavya",
     "file": "04_kavya.wav",
     "text": "మనం [1] ఏమీ చెప్పలేదు, అందుకే గెస్ చేసింది.",
     "show": "We told it [1] nothing, so it guessed.",
