   "lines": [
    {
     "who": "teja",
     "file": "11_teja.wav",
     "text": "మేం టెస్ట్ చేశాం. లైన్ లేకుంటే ఒక్క ప్రశ్న కూడా అడగలేదు. లైన్ ఉంటే ప్రతిసారీ అడిగింది.",
     "show": "We tested it. Without the line, not one question. With it, it asked every time.",
     "maxgap": 0.3,
     "gap": 1.3,
     "gain_db": 0.3
    },
    {
     "who": "nanna",
     "file": "12_nanna.wav",
     "text": "పెసరట్టు, మన పాట కూడా? ఎవరు ప్లాన్ చేశారు?",
     "show": "Pesarattu, and our song too? Who planned this?",
     "maxgap": 0.3,
     "gap": 0.2,
     "gain_db": 0.3
    },
    {
     "who": "kavya",
     "file": "13_kavya.wav",
     "text": "ఏ.ఐ. నే నాన్నా, మమ్మల్ని అడిగాకే.",
     "show": "The AI, Nanna. After it asked us.",
     "maxgap": 0.3,
     "gap": 0.2,
     "gain_db": 0.3
    },
    {
     "who": "teja",
     "file": "14_teja.wav",
     "text": "సరే సరే! ఇప్పుడు నా బర్త్ డే ప్లాన్ చెయ్!",
     "show": "Okay, okay! Now plan my birthday!",
     "maxgap": 0.3,
     "gap": 0.8,
     "gain_db": 0.3
    },
    {
     "who": "kavya",
     "file": "15_kavya.wav",
     "text": "తేజా! లైన్ మర్చిపోయావ్!",
