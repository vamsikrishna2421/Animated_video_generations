     "show": "You told him, train it once, it'll remember.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ravi",
     "file": "11_ravi.wav",
     "text": "జూన్ ధరలు ఎంతమందికి వేశావు?",
