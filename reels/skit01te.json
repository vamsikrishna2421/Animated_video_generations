     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ai",
     "file": "04_ai.wav",
     "text": "కిలో అరవై.",
     "show": "Sixty.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ravi",
     "file": "05_ravi.wav",
     "text": "ఈ వారం కిలో నలభై!",
     "show": "They're FORTY this week!",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ai",
     "file": "06_ai.wav",
     "text": "నా నోట్స్ లో అలా లేదు.",
     "show": "Not in my notes.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ravi",
     "file": "07_ravi.wav",
     "text": "ఏ నోట్స్?",
     "show": "What notes?",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ai",
     "file": "08_ai.wav",
     "text": "మీ మేనల్లుడు నాకు ట్రైన్ చేసిన నోట్స్. జూన్ లో.",
     "show": "The notes your nephew trained into me. In June.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ravi",
     "file": "09_ravi.wav",
     "text": "జూన్ ఆ?!",
