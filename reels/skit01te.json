   "lines": [
    {
     "who": "ravi",
     "file": "01_ravi.wav",
     "text": "ఏ ఐ, కాలనీ మొత్తం నన్ను మోసగాడు అంటోంది!",
     "show": "AI! The whole colony is calling me a cheat!",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ai",
     "file": "02_ai.wav",
     "text": "విచిత్రం. నేను అందరికీ సరైన ధరే వేశాను.",
     "show": "Strange. I charged everyone the right price.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "ravi",
     "file": "03_ravi.wav",
     "text": "టమాటాలు?",
