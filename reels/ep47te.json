   "lines": [
    {
     "who": "ravi",
     "file": "01_ravi.wav",
     "text": "ఒక్క రూపాయా?! [1] పదహారు వందల బియ్యం బస్తా?!",
     "show": "One rupee?! My ₹1,600 rice bag?!",
