   "lines": [
    {
     "who": "caller",
     "file": "01_caller.wav",
     "text": "అమ్మా! నేనే, చిన్నుని! నా ఫోన్ పోయింది, ఫ్రెండ్ ఫోన్ నుంచి చేస్తున్నా!",
     "show": "Amma! It's me, Chinnu! I lost my phone, this is a friend's!",
     "maxgap": 0.3,
     "gap": 0.26
    },
    {
     "who": "amma",
     "file": "02_amma.wav",
     "text": "చిన్నూ?",
     "show": "Chinnu?",
     "maxgap": 0.3,
     "gap": 0.26
    },
    {
     "who": "caller",
     "file": "03_caller.wav",
     "text": "యాక్సిడెంట్ అయ్యింది! అర్జెంట్ గా యాభై వేలు కావాలి!",
     "show": "I had an accident! I need fifty thousand, right now!",
     "maxgap": 0.3,
     "gap": 0.26
    },
    {
     "who": "chinnu",
     "file": "04_chinnu.wav",
     "text": "అమ్మా, అది నేను కాదు!",
     "show": "Amma, that's not me!",
     "maxgap": 0.3,
     "gap": 0.26
    },
    {
     "who": "caller",
     "file": "05_caller.wav",
     "text": "నాన్నకి చెప్పకు! ఈ నంబర్ కి పంపించు!",
     "show": "Don't tell Nanna! Send it to this number!",
     "maxgap": 0.3,
     "gap": 0.26
    },
    {
     "who": "amma",
     "file": "06_amma.wav",
     "text": "అచ్చం నీ గొంతే!",
     "show": "But it's YOUR voice!",
     "maxgap": 0.3,
     "gap": 0.26
    }
   ]
