    {
     "who": "amma",
     "file": "08_amma.wav",
     "text": "మరి నువ్వే అని నాకు ఎలా తెలుస్తుంది?",
     "show": "Then how will I ever know it's you?",
     "maxgap": 0.3,
     "gap": 0.26
