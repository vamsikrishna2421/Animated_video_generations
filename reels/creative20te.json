     "maxgap": 0.28,
     "gap": 0.25,
     "tempo": 1.05,
     "tts": "చాట్ బాట్ ఆదివారం అంది...",
     "file2": "01b_tarun.wav",
     "tts2": "క్యాలెండర్ లో బుధవారం!",
