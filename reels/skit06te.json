   "lines": [
    {
     "who": "a",
     "file": "03_a.wav",
     "text": "రాములు టిఫిన్సా? ఎప్పుడూ వినలేదమ్మా.",
     "show": "Ramulu Tiffins? Never heard of it.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "b",
     "file": "04_b.wav",
     "text": "తెలీదండి. ఫోన్ చేసి అడుగుతా.",
     "show": "No idea. I'll call and ask.",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.3
    },
    {
     "who": "c",
     "file": "05_c.wav",
     "text": "ఆరున్నరకే! అక్కడ నెయ్యి కారం దోశ చాలా ఫేమస్!",
     "show": "Six thirty sharp! Their ghee karam dosa is famous!",
     "maxgap": 0.3,
     "gap": 0.35
    },
    {
     "who": "host",
     "file": "06_host.wav",
     "text": "అబ్బో, ఎంత ష్యూర్! సోర్స్?",
     "show": "So sure! Source?",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "c",
     "file": "07_c.wav",
     "text": "హైదరాబాద్ ఫుడ్ గైడ్, నలభై రెండో పేజీ.",
     "show": "Hyderabad Food Guide, page 42.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "a",
     "file": "08_a.wav",
     "text": "అలాంటి పుస్తకమే లేదు!",
     "show": "There's no such book!",
     "maxgap": 0.3,
     "gap": 0.24,
     "gain_db": 0.5
    },
    {
     "who": "host",
     "file": "09_host.wav",
     "text": "టైం అయిపోయింది! ఏఐ ఎవరు?",
