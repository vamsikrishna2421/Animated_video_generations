    "handle": "@ai_maastaaru_telugu"
   },
   "lines": [
    {
     "who": "host",
     "file": "10_host.wav",
     "text": "సి! మీసం పెట్టుకున్న ఫోన్!",
     "show": "C! A phone with a moustache!",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "host",
     "file": "11_host.wav",
     "text": "రాములు టిఫిన్స్? [1] మేమే కల్పించాం. అసలు లేనే లేదు.",
     "show": "Ramulu Tiffins? We made it up. It doesn't exist.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "c",
     "file": "12_c.wav",
     "text": "కానీ నేను చాలా ష్యూర్ గా చెప్పానే!",
     "show": "But I said it so surely!",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "host",
     "file": "13_host.wav",
     "text": "అదే ట్రాప్. [1] ఏఐ \"తెలీదు\" అని అరుదుగా అంటుంది. [2] ఊహించి చెప్పేస్తుంది.",
     "show": "That's the trap. AI rarely says \"I don't know\". It guesses.",
     "maxgap": 0.3,
     "gap": 0.6
    },
    {
     "who": "host",
     "file": "14_host.wav",
     "text": "అందుకే చెప్పండి: \"ష్యూర్ కాకపోతే, తెలీదు అని చెప్పు.\" [1] ఇప్పుడు, రాములు టిఫిన్స్?",
     "show": "So tell it: \"If you're not sure, say I don't know.\" Now, Ramulu Tiffins?",
     "maxgap": 0.3,
     "gap": 0.45
    },
    {
     "who": "c",
     "file": "15_c.wav",
     "text": "నాకు తెలీదు.",
     "show": "I don't know.",
     "maxgap": 0.3,
     "gap": 0.24
    },
    {
     "who": "a",
     "file": "16_a.wav",
     "text": "హమ్మయ్య, నిజాయితీ జవాబు!",
     "show": "Finally, an honest answer!",
     "maxgap": 0.3,
     "gap": 0.05,
     "gain_db": 0.5
    }
   ]
  }
