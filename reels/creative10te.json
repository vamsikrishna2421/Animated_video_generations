    {
     "who": "thatha",
     "file": "01_thatha.wav",
     "text": "ఏ ఐ నాకు రెండు మూడు నెలలే టైం ఇచ్చింది!",
     "show": "The AI gave me only 2-3 months!",
     "maxgap": 0.3,
     "gap": 0.15,
     "gain_db": 1.1
    },
    {
     "who": "kamala",
     "file": "02_kamala.wav",
     "text": "మూడు నెలలా?! మావయ్యా!",
     "show": "Three months?! Mavayya!",
     "maxgap": 0.3,
     "gap": 0.75,
     "gain_db": 1.1
    },
    {
     "who": "sravani",
     "file": "03_sravani.wav",
     "text": "తాతయ్యా, ఫోన్ ఇటివ్వు.",
     "show": "Thathayya, give me the phone.",
     "maxgap": 0.3,
     "gap": 0.2,
     "gain_db": 0.3
    },
    {
     "who": "sravani",
     "file": "04_sravani.wav",
     "text": "గత రెండు మూడు నెలల షుగర్ [1] సగటు అని రాసుంది. ఇది టెస్ట్ తాతయ్యా, కౌంట్ డౌన్ కాదు.",
     "show": "It says your average sugar over the PAST 2-3 months. It's a test, Thathayya. Not a countdown.",
     "maxgap": 0.3,
     "gap": 0.3,
     "tempo": 1.15,
     "gain_db": 0.3
    },
    {
     "who": "thatha",
     "file": "05_thatha.wav",
     "text": "మరి గ్లైకేటెడ్ హీమోగ్లోబిన్ ఏంటి? షార్టర్ లైఫ్ ఎక్స్పెక్టెన్సీ ఏంటి?!",
     "show": "Then what's \"glycated haemoglobin\"? What's \"shorter life expectancy\"?!",
     "maxgap": 0.3,
     "gap": 0.25,
     "tempo": 1.18,
     "gain_db": 0.3
    }
   ]
