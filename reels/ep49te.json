   "lines": [
    {
     "who": "suresh",
     "file": "01_suresh.wav",
     "text": "పదిహేను వేల జీతం, ఎనిమిదేళ్లు... [1] ఫ్రీ యాప్ వల్ల నా పని పోతుందా?!",
     "show": "₹15,000 salary, 8 years... and I lose my work because of a free app?!",
     "maxgap": 0.25,
     "gap": 0.2,
     "tempo": 1.06,
     "gain_db": 0.5
    },
    {
     "who": "ravi",
     "file": "02_ravi.wav",
     "text": "టెన్షన్ పడకురా! నీ పేపర్ పని మీదే టెస్ట్ చేశా.",
     "show": "Don't stress! I tested it only on your paper work.",
     "maxgap": 0.25,
     "gap": 0.2,
     "tempo": 1.06,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "03_ai.wav",
     "text": "సురేష్ పేపర్ పని, ఇరవై ఐదు సార్లు. <pause 0.8> [1] పందొమ్మిది కరెక్ట్.",
     "show": "Suresh's paper work, 25 times. 19 correct.",
     "maxgap": 0.25,
     "gap": 0.3,
     "tempo": 1.06,
     "gain_db": -1.0,
     "tts": "సురేష్ పేపర్ పని, ఇరవై ఐదు సార్లు.",
     "file2": "03b_ai.wav",
     "tts2": "పందొమ్మిది కరెక్ట్.",
     "pause": 0.8
    },
    {
     "who": "suresh",
     "file": "04_suresh.wav",
     "text": "పందొమ్మిదా?! చాలా వరకు!",
     "show": "19?! Most of it!",
     "maxgap": 0.25,
     "gap": 0.3,
     "tempo": 1.06,
     "gain_db": 0.5
    },
    {
     "who": "ai",
     "file": "05_ai.wav",
     "text": "లెక్కలు, జీ ఎస్ టీ, స్టాక్ లిస్ట్: పదిహేనుకి పదిహేను. [1] కానీ ప్రతి ఆఫర్ మెసేజ్ లో, ఒక ఖాళీ, లేదా ఒక తప్పు ఉంది.",
     "show": "Sums, GST, stock lists: 15 out of 15. But every offer message had a blank or a mistake.",
     "maxgap": 0.25,
     "gap": 0.3,
     "tempo": 1.06,
     "gain_db": -1.0
    },
    {
     "who": "suresh",
     "file": "06_suresh.wav",
     "text": "షాప్ పేరు దానికి ఎవరూ చెప్పలేదు! [1] చెక్ చేసేది ఎవరు? నేనే!",
     "show": "Nobody told it the shop's name! Who checks it? Me!",
     "maxgap": 0.25,
     "gap": 0.25,
     "tempo": 1.06,
     "gain_db": 0.5
    },
    {
     "who": "ravi",
     "file": "07_ravi.wav",
     "text": "మరి సురేష్ పని పోతుందా, లేదా?",
     "show": "So does Suresh lose his work, or not?",
     "maxgap": 0.25,
     "gap": 0.2,
     "tempo": 1.06,
     "gain_db": 0.5
    }
   ]
  },
