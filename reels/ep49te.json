   "lines": [
    {
     "who": "ravi",
     "file": "12_ravi.wav",
     "text": "అంటే: ఏఐ డ్రాఫ్ట్ చేస్తుంది, నువ్వు చెక్ చేస్తావ్. [1] బస్తాలు, కస్టమర్లు: నీవే.",
     "show": "So: the AI drafts, you check. Sacks, customers: yours.",
     "maxgap": 0.25,
     "gap": 0.5,
     "tempo": 1.03,
     "gain_db": 0.5
    },
    {
     "who": "ravi",
     "file": "13_ravi.wav",
     "text": "సరే, నువ్వే ఉంటావ్. [1] యాప్ కూడా నువ్వే నడుపు.",
     "show": "Fine, you stay. And you run the app too.",
     "maxgap": 0.25,
     "gap": 0.2,
     "tempo": 1.03,
     "gain_db": 0.5
    },
    {
     "who": "suresh",
     "file": "14_suresh.wav",
     "text": "అయితే, నెలకి ఇరవై వేలు.",
     "show": "Then, ₹20,000 a month.",
     "maxgap": 0.25,
     "gap": 0.0,
     "tempo": 1.03,
     "gain_db": 0.5
    }
   ]
  }
 ]
