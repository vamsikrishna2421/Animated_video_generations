      "captions": [
        {
          "text": "Here's a common myth.",
          "from": 10,
          "to": 55
        },
        {
          "text": "People think L L Ms",
          "from": 57,
          "to": 95
        },
        {
          "text": "know everything,",
          "from": 97,
          "to": 122
        },
        {
          "text": "and are always right.",
          "from": 126,
          "to": 173
        },
        {
          "text": "Not true.",
          "from": 176,
          "to": 206
        },
        {
          "text": "They predict likely words,",
          "from": 208,
          "to": 252
        },
        {
          "text": "so they can sound confident",
          "from": 256,
          "to": 298
        },
        {
          "text": "and still be wrong.",
