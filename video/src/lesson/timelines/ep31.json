      "captions": [
        {
          "text": "LoRA stands for low rank adaptation.",
          "from": 10,
          "to": 98
        },
        {
          "text": "Think of the big model",
          "from": 101,
          "to": 146
        },
        {
          "text": "as a thick textbook.",
          "from": 146,
          "to": 188
        },
        {
          "text": "Instead of rewriting the whole",
          "from": 190,
          "to": 226
        },
        {
          "text": "book, you stick a few",
          "from": 228,
          "to": 268
        },
        {
          "text": "sticky notes inside,",
          "from": 270,
          "to": 318
        },
        {
          "text": "and the notes change how",
          "from": 320,
          "to": 356
        },
        {
          "text": "the book is read.",
          "from": 357,
          "to": 396
        }
      ],
      "image": null
