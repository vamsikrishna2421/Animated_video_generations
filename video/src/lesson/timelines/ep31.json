      "captions": [
        {
          "text": "Here's how it works.",
          "from": 10,
          "to": 53
        },
        {
          "text": "Take a pretrained model and",
          "from": 56,
          "to": 101
        },
        {
          "text": "freeze all its weights.",
          "from": 104,
          "to": 153
        },
        {
          "text": "Attach small adapter matrices to",
          "from": 156,
          "to": 221
        },
        {
          "text": "some of its layers.",
          "from": 223,
          "to": 262
        },
        {
          "text": "Train only those adapters on",
          "from": 266,
          "to": 316
        },
        {
          "text": "your own examples.",
          "from": 317,
          "to": 361
        },
        {
          "text": "Save the adapter,",
          "from": 364,
          "to": 398
        },
        {
          "text": "often just a few megabytes.",
          "from": 400,
          "to": 459
        },
        {
          "text": "At run time,",
          "from": 462,
          "to": 492
        },
        {
          "text": "plug it in,",
          "from": 494,
          "to": 522
        },
        {
          "text": "and the model behaves in",
          "from": 524,
          "to": 560
        },
        {
          "text": "your custom way.",
          "from": 561,
          "to": 601
        }
