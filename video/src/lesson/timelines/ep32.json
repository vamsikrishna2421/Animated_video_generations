          "from": 228,
          "to": 278
        },
        {
          "text": "that captures its meaning.",
          "from": 279,
          "to": 335
        },
        {
          "text": "Store them in a vector database.",
          "from": 339,
          "to": 404
        },
        {
          "text": "When a question comes in,",
          "from": 405,
          "to": 450
        },
        {
          "text": "find the closest chunks,",
          "from": 452,
          "to": 496
        },
        {
          "text": "then rerank them,",
          "from": 498,
          "to": 532
        },
        {
          "text": "and send the best few",
          "from": 534,
