    {
      "type": "code",
      "data": {
        "heading": "Hello, AI!",
        "file": "first_call.py",
        "lines": [
          "import anthropic",
          "",
          "client = anthropic.Anthropic()",
          "",
          "reply = client.messages.create(",
          "    model=\"claude-sonnet-5\",",
          "    max_tokens=300,",
          "    messages=[{\"role\": \"user\",",
          "      \"content\": \"Explain AI in one line\"}],",
          ")",
          "print(reply.content[0].text)"
        ],
        "groups": [
          2,
          2,
          3,
          3,
          1
        ],
        "output": [
          "$ python first_call.py",
          "AI is software that learns patterns",
          "from data to make predictions."
        ]
