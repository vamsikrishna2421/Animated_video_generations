    {
      "type": "code",
      "data": {
        "heading": "A talking assistant",
        "file": "voice_bot.py",
        "lines": [
          "import anthropic, whisper, pyttsx3",
          "import sounddevice as sd, scipy.io.wavfile as wav",
          "stt = whisper.load_model(\"base\")",
          "tts = pyttsx3.init()",
          "client = anthropic.Anthropic()",
          "while True:",
          "    input(\"Press Enter, then speak for 5 seconds\")",
          "    audio = sd.rec(5 * 16000, samplerate=16000, channels=1)",
          "    sd.wait(); wav.write(\"q.wav\", 16000, audio)",
          "    text = stt.transcribe(\"q.wav\")[\"text\"]",
          "    r = client.messages.create(model=\"claude-sonnet-5\",",
          "        max_tokens=200, system=\"Answer in one sentence.\",",
          "        messages=[{\"role\": \"user\", \"content\": text}])",
          "    tts.say(r.content[0].text)",
          "    tts.runAndWait()"
        ],
        "groups": [
          2,
          3,
          4,
          1,
          3,
          2
        ],
        "output": [
          "🎤 You: What's the capital of Telangana?",
          "🔊 AI: Hyderabad is the capital of Telangana."
        ]
      },
