    {
      "type": "code",
      "data": {
        "heading": "Ask your PDF",
        "file": "ask.py",
        "lines": [
          "import anthropic, chromadb",
          "db = chromadb.PersistentClient(\"db\")",
          "col = db.get_collection(\"docs\")",
          "q = input(\"Ask: \")",
          "hits = col.query(query_texts=[q], n_results=4)",
          "context = \"\\n\\n\".join(",
          "    f\"[{i}] {d}\" for i, d in",
          "    zip(hits[\"ids\"][0], hits[\"documents\"][0]))",
          "reply = anthropic.Anthropic().messages.create(",
          "    model=\"claude-sonnet-5\", max_tokens=500,",
          "    system=\"Answer ONLY from the sources. \"",
          "           \"Cite source numbers. If unsure, say so.\",",
          "    messages=[{\"role\": \"user\",",
          "      \"content\": f\"Sources:\\n{context}\\n\\nQ: {q}\"}])",
          "print(reply.content[0].text)"
        ],
        "groups": [
          3,
          2,
          3,
          6,
          1
        ],
        "output": [
          "Ask: Is dental treatment covered?",
          "Only dental treatment needed after an",
          "accident is covered [12]. Routine care is not [13]."
        ]
      },
