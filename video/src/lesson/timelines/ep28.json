    {
      "type": "myth",
      "data": {
        "myth": "A transformer looks up answers in a database of facts.",
        "fact": "Knowledge is spread across billions of parameters as patterns, which is why it can also be wrong.",
        "tip": "Patterns, not a database"
      },
      "from": 3561,
      "durationInFrames": 530,
      "voiceFrom": 10,
      "audio": "lessons/ep28/voice_07.wav",
      "cues": [
        59,
