    {
      "type": "code",
      "data": {
        "heading": "An agent in 17 lines",
        "file": "agent.py",
        "lines": [
          "tools = [{\"name\": \"get_weather\",",
          "  \"description\": \"Current weather for a city\",",
          "  \"input_schema\": {\"type\": \"object\",",
          "    \"properties\": {\"city\": {\"type\": \"string\"}}}}]",
          "def get_weather(city): return f\"{city}: 31°C, sunny\"",
          "msgs = [{\"role\": \"user\", \"content\": \"Weather in Hyderabad?\"}]",
          "while True:",
          "    r = client.messages.create(model=\"claude-sonnet-5\",",
          "        max_tokens=500, tools=tools, messages=msgs)",
          "    if r.stop_reason != \"tool_use\": break",
          "    call = next(b for b in r.content if b.type == \"tool_use\")",
          "    result = get_weather(**call.input)",
          "    msgs.append({\"role\": \"assistant\", \"content\": r.content})",
          "    msgs.append({\"role\": \"user\", \"content\": [",
          "        {\"type\": \"tool_result\", \"tool_use_id\": call.id,",
          "         \"content\": result}]})",
          "print(r.content[0].text)"
        ],
        "groups": [
          4,
          1,
          1,
          3,
          1,
          2,
          4,
          1
        ],
        "output": [
          "$ python agent.py",
          "It's 31°C and sunny in Hyderabad right now!"
        ]
      },
