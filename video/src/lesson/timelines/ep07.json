      "captions": [
        {
          "text": "RAG stands for retrieval augmented generation.",
          "from": 10,
          "to": 103
        },
        {
          "text": "In simple words,",
          "from": 106,
          "to": 129
        },
        {
          "text": "it means,",
          "from": 134,
          "to": 154
        },
        {
          "text": "find the right information first,",
          "from": 155,
          "to": 200
        },
        {
          "text": "and then answer.",
          "from": 203,
          "to": 232
        },
        {
          "text": "So first,",
          "from": 235,
          "to": 249
        },
        {
          "text": "retrieve, which means search your documents.",
          "from": 254,
          "to": 316
        },
        {
          "text": "Then, augment,",
          "from": 320,
          "to": 345
        },
        {
          "text": "which means add what you",
          "from": 348,
          "to": 377
        },
        {
          "text": "found to the prompt.",
          "from": 378,
          "to": 411
        },
        {
          "text": "And finally,",
          "from": 413,
          "to": 440
        },
        {
          "text": "generate, where the LLM writes",
          "from": 442,
          "to": 506
        },
        {
          "text": "the answer using that information.",
          "from": 506,
          "to": 574
        }
      ],
      "image": null
    },
