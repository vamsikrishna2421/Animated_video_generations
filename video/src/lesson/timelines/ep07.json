    {
      "type": "definition",
      "data": {
        "term": "Retrieval-Augmented Generation",
        "short": "RAG",
        "definition": "Find the right information first, then let the AI answer using it.",
        "chips": [
          [
            "Search",
            "Retrieve"
          ],
          [
            "Plus",
            "Augment"
          ],
          [
