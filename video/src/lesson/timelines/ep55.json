    {
      "type": "code",
      "data": {
        "heading": "A notes MCP server",
        "file": "notes.py",
        "lines": [
          "from mcp.server.fastmcp import FastMCP",
          "mcp = FastMCP(\"notes\")",
          "notes = []",
          "",
          "@mcp.tool()",
          "def add_note(text: str) -> str:",
          "    \"\"\"Save a note.\"\"\"",
          "    notes.append(text)",
          "    return \"Saved!\"",
          "",
          "@mcp.tool()",
          "def list_notes() -> list[str]:",
          "    \"\"\"Return all saved notes.\"\"\"",
          "    return notes",
          "if __name__ == \"__main__\":",
          "    mcp.run()"
        ],
        "groups": [
          1,
          3,
          6,
          4,
          2
        ],
        "output": [
          "$ claude mcp add notes -- python notes.py",
          "You: note down, buy milk",
          "AI: Saved! You have 1 note."
        ]
      },
      "from": 1576,
      "durationInFrames": 910,
      "voiceFrom": 10,
