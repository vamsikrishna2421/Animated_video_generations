    {
      "type": "code",
      "data": {
        "heading": "A chatbot in 13 lines",
        "file": "chatbot.py",
        "lines": [
          "import anthropic",
          "client = anthropic.Anthropic()",
          "hist = []",
          "while True:",
          "    msg = input(\"You: \")",
          "    hist.append({\"role\": \"user\", \"content\": msg})",
          "    reply = client.messages.create(",
          "        model=\"claude-sonnet-5\", max_tokens=500,",
          "        system=\"You are a friendly AI tutor.\",",
          "        messages=hist)",
          "    text = reply.content[0].text",
          "    hist.append({\"role\": \"assistant\", \"content\": text})",
          "    print(\"AI:\", text)"
        ],
        "groups": [
          3,
          3,
          4,
          1,
          2
        ],
        "output": [
          "You: hi, I'm Ravi",
          "AI: Namaste Ravi! What shall we learn?",
          "You: what's my name?",
          "AI: Your name is Ravi!"
        ]
      },
      "from": 1333,
      "durationInFrames": 673,
      "voiceFrom": 10,
      "audio": "lessons/ep51/voice_04.wav",
