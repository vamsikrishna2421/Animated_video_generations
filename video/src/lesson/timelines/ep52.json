    {
      "type": "code",
      "data": {
        "heading": "Load, chunk, store",
        "file": "ingest.py",
        "lines": [
          "from pypdf import PdfReader",
          "import chromadb",
          "",
          "reader = PdfReader(\"policy.pdf\")",
          "text = \" \".join(p.extract_text() for p in reader.pages)",
          "",
          "words = text.split()",
          "chunks = [\" \".join(words[i:i+200])",
          "          for i in range(0, len(words), 150)]",
          "",
          "db = chromadb.PersistentClient(\"db\")",
          "col = db.get_or_create_collection(\"docs\")",
          "col.add(documents=chunks,",
          "        ids=[str(i) for i in range(len(chunks))])",
          "print(len(chunks), \"chunks stored\")"
        ],
        "groups": [
          3,
          3,
          4,
          2,
          3
        ],
        "output": [
          "$ python ingest.py",
          "48 chunks stored"
        ]
      },
